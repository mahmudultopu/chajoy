{
  "name": "chajoy-bd",
  "version": "1.0.0",
  "private": true,
  "description": "Online ordering and back office for CHAJOY Ice Cream & Tea, Dhaka",
  "author": "Mahmudul Hasan Topu",
  "license": "UNLICENSED",
  "homepage": "https://chajoy-bd.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahmudultopu/chajoy.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e-smoke.ts",
    "test:e2e:admin": "tsx scripts/e2e-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "db:demo-ops": "tsx scripts/demo-ops.ts",
    "db:check": "tsx scripts/db-check.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "images:extract": "python scripts/menu-images/extract_menu_images.py",
    "screenshots": "node scripts/screenshots-readme.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@vercel/blob": "2.8.2",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "leaflet": "1.9.4",
    "lucide-react": "1.59.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "drizzle-kit": "0.31.11",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
