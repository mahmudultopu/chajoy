# CHAJOY BD — environment variables (names only; never commit real values)

# ---- Site
# Public base URL, used for canonical links, sitemap and payment callbacks
NEXT_PUBLIC_SITE_URL=

# ---- Database
# Unset or "pglite://.data/pglite" = embedded Postgres on local disk (development only).
# Production: a PostgreSQL connection string (Supabase, Neon, RDS, ...).
DATABASE_URL=
# disable | require (encrypted, no CA check — typical for Supabase/Neon) | verify (needs DATABASE_CA_CERT)
DATABASE_SSL=
DATABASE_CA_CERT=
DATABASE_POOL_MAX=

# ---- File storage for admin-uploaded images
# local (default; files in UPLOAD_DIR, served at /media) | vercel-blob (default when BLOB_READ_WRITE_TOKEN is set) | supabase
STORAGE_DRIVER=
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Hostname of the public image host (e.g. your-project.supabase.co) so next/image can optimise it
NEXT_PUBLIC_MEDIA_HOST=

# ---- Payments: SSLCommerz (covers bKash, Nagad, Rocket and cards)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" (default) uses the sandbox; set "false" only with live credentials
SSLCOMMERZ_SANDBOX=
# Sent to SSLCommerz when a customer leaves email blank (the gateway requires one)
SSLCOMMERZ_FALLBACK_EMAIL=

# ---- Maps & address search
# Tile server (default: OpenStreetMap's public tiles — fine for light use; use a provider for production traffic)
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Nominatim-compatible geocoder (default: nominatim.openstreetmap.org, max ~1 req/s)
GEOCODER_URL=
# Identifying User-Agent required by Nominatim's usage policy, e.g. "CHAJOY-BD/1.0 (ops@yourdomain)"
GEOCODER_USER_AGENT=

# ---- Admin bootstrap (used only by `npm run admin:create`)
ADMIN_PASSWORD=

# ---- End-to-end test (scripts/e2e-smoke.ts)
BASE_URL=
CHROME_PATH=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_SHOTS=
